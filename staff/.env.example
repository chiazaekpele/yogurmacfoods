EMAIL_FROM="Yogurmac Foods <staff@yogurmacfoods.com>"

# ── Upstash Redis (same instance as the shop) ────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# ── Cloudinary (signed product photo uploads) ────────────

// Shared schema for the shop and (later) the staff portal.
// Models follow docs/yogurmac-shop-prd.md §6, plus the additions in
// docs/yogurmac-trd.md §5.4 (PendingCheckout, dedupeKey, SubscriptionPayment,
// Order.amountPaid). Money is Decimal(12,2) in naira; times are UTC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The staff portal (staff/) gets its own copy of the client.
generator staffClient {
  provider = "prisma-client"
  output   = "../staff/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  YOGURT
  GRANOLA
  ENERGY_BAR
  // Wellness subscription boxes (13 Oct 2026): tiers are the variants'
  // "flavour"; customers buy one box or one a day for N days.
  WELLNESS_BOX
}

enum OrderStatus {
  CONFIRMED
  IN_PRODUCTION
  READY
  OUT_FOR_DELIVERY
  DELIVERED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum DonationStatus {
  PENDING
  PAID
}

enum Role {
  ADMIN
  STAFF
}

enum ReviewCadence {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum SetbackCategory {
  INGREDIENT_SHORTAGE
  EQUIPMENT_ISSUE
  PACKAGING_ISSUE
  OTHER
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String
  category    Category
  images      String[]
  isFeatured  Boolean          @default(false)
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, isFeatured])
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  flavour     String
  size        String
  price       Decimal     @db.Decimal(12, 2)
  isAvailable Boolean     @default(true)
  // The product photo shown when this option is chosen (one of Product.images).
  imageUrl    String?
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([productId, flavour, size])
  @@index([productId])
}

model LGAShippingRate {
  id          String   @id @default(cuid())
  lgaName     String   @unique
  // Null means the admin has not set a fee yet; checkout is blocked for that LGA.
  shippingFee Decimal? @db.Decimal(12, 2)
  updatedAt   DateTime @updatedAt
}

// Holds a validated cart between payment initialisation and the Paystack
// webhook. The Order is only created from this once payment is confirmed.
model PendingCheckout {
  id            String    @id @default(cuid())
  orderId       String    @unique
  customerName  String
  customerEmail String
  customerPhone String
  lga           String
  exactAddress  String
  landmark      String?
  items         Json
  subtotal      Decimal   @db.Decimal(12, 2)
  shippingFee   Decimal   @db.Decimal(12, 2)
  total         Decimal   @db.Decimal(12, 2)
  accessCode    String?
  customerId    String?
  consumedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

model Order {
  id            String          @id @default(cuid())
  orderId       String          @unique
  customerName  String
  customerEmail String
  customerPhone String
  lga           String
  exactAddress  String
  landmark      String?
  subtotal      Decimal         @db.Decimal(12, 2)
  shippingFee   Decimal         @db.Decimal(12, 2)
  total         Decimal         @db.Decimal(12, 2)
  amountPaid    Decimal         @db.Decimal(12, 2)
  status        OrderStatus     @default(CONFIRMED)
  paystackRef   String          @unique
  emailSent     Boolean         @default(false)
  emailError    String?
  items         OrderItem[]
  // Set when the order was placed while signed in (required since 13 Oct 2026).
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  claim         OrderClaim?
  setbacks      SetbackReport[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([lga])
  @@index([customerPhone])
  @@index([customerName])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  // Snapshots taken at order time, so later catalogue edits never change an order.
  productName String
  flavour     String
  size        String
  quantity    Int
  // Wellness boxes: one delivered each day for this many days (1 otherwise).
  // Line total = unitPrice × quantity × days.
  days        Int            @default(1)
  unitPrice   Decimal        @db.Decimal(12, 2)

  @@index([orderId])
  @@index([variantId])
}

model SubscriptionTier {
  id               String         @id @default(cuid())
  name             String
  description      String
  monthlyAmount    Decimal        @db.Decimal(12, 2)
  paystackPlanCode String?        @unique
  isActive         Boolean        @default(true)
  sortOrder        Int            @default(0)
  subscriptions    Subscription[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Subscription {
  id                       String                @id @default(cuid())
  tierId                   String
  tier                     SubscriptionTier      @relation(fields: [tierId], references: [id], onDelete: Restrict)
  subscriberName           String
  subscriberEmail          String
  paystackSubscriptionCode String                @unique
  paystackCustomerCode     String
  status                   SubscriptionStatus    @default(ACTIVE)
  // Set by subscription.not_renew: stays ACTIVE until the paid period ends.
  endsAtPeriodEnd          Boolean               @default(false)
  // Set by invoice.payment_failed so the admin can follow up.
  lastPaymentFailedAt      DateTime?
  startDate                DateTime
  nextPaymentDate          DateTime?
  payments                 SubscriptionPayment[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@index([tierId, status])
  @@index([paystackCustomerCode])
}

model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  paystackRef    String       @unique
  amount         Decimal      @db.Decimal(12, 2)
  status         String
  paidAt         DateTime
  createdAt      DateTime     @default(now())
}

model ImpactStat {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  value     Int
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("PAYSTACK")
  eventType   String
  dedupeKey   String    @unique
  paystackRef String?
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  note        String?
  createdAt   DateTime  @default(now())
}

// Problems the admin must see on the staff dashboard: payment mismatches,
// payments with no pending checkout, failed emails.
model SystemAlert {
  id         String    @id @default(cuid())
  type       String
  message    String
  reference  String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolvedAt, createdAt])
}

// Insert-only. actorId is null for system actions (e.g. webhook-created orders).
model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

// One-time gift to the Ythirst project: ₦500 per child (confirmed 10 Oct 2026).
// Created PENDING when Paystack is initialised; only the signed webhook marks it
// PAID, and only PAID donations count towards the live counter.
model Donation {
  id         String         @id @default(cuid())
  // YMG-YYYYMMDD-XXXXX, also the Paystack reference.
  reference  String         @unique
  donorName  String?
  donorEmail String
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  children   Int
  amount     Decimal        @db.Decimal(12, 2)
  amountPaid Decimal?       @db.Decimal(12, 2)
  status     DonationStatus @default(PENDING)
  emailSent  Boolean        @default(false)
  paidAt     DateTime?
  createdAt  DateTime       @default(now())

  @@index([status, paidAt])
  @@index([createdAt])
  @@index([customerId])
}

// Shop customer account (13 Oct 2026). Passwords and sessions live in Neon Auth;
// this row holds the saved checkout details.
model Customer {
  id           String     @id @default(cuid())
  authUserId   String     @unique
  email        String     @unique
  name         String
  phone        String?
  lga          String?
  exactAddress String?
  landmark     String?
  orders       Order[]
  donations    Donation[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Homepage hero carousel, managed from /admin (14 Oct 2026).
model HeroSlide {
  id         String   @id @default(cuid())
  imageUrl   String
  alt        String
  href       String   @default("/products")
  // CSS object-position, e.g. "center 30%".
  position   String?
  // "contain" shows the whole image on `background` (for graphics with text).
  fit        String   @default("cover")
  background String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Images uploaded from /admin, stored in the database and served at
// /media/<id> (no third-party image host needed).
model MediaImage {
  id        String   @id @default(cuid())
  mimeType  String
  bytes     Bytes
  size      Int
  fileName  String?
  createdAt DateTime @default(now())
}

// ── Staff portal (docs/yogurmac-staff-prd.md §8, TRD §5.4) ────────────────────

// Passwords and sessions live in Neon Auth (schema neon_auth); this row holds
// the portal's own account state. authUserId links the two once the invite is
// accepted. Invited: no authUserId, isActive false. Deactivated: isActive false
// with authUserId set.
model User {
  id              String    @id @default(cuid())
  authUserId      String?   @unique
  name            String
  email           String    @unique
  role            Role      @default(STAFF)
  isActive        Boolean   @default(false)
  inviteTokenHash String?   @unique
  inviteExpiry    DateTime?
  lastActiveAt    DateTime?
  deactivatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  claims            OrderClaim[]
  setbacks          SetbackReport[]
  dailyLogs         DailyLog[]
  submissions       ReviewSubmission[]
  assignments       TaskAssignment[]
  tasksCreated      Task[]             @relation("TaskCreatedBy")
  announcements     Announcement[]     @relation("AnnouncementCreatedBy")
  announcementReads AnnouncementRead[]
}

// One cadence and question set. Changing questions after anyone has answered
// ends this cycle and starts a new one, so past answers keep their questions.
model ReviewCycle {
  id          String             @id @default(cuid())
  cadence     ReviewCadence
  startDate   DateTime           @db.Date
  endDate     DateTime?
  isActive    Boolean            @default(false)
  questions   ReviewQuestion[]
  submissions ReviewSubmission[]
  createdAt   DateTime           @default(now())
}

model ReviewQuestion {
  id              String           @id @default(cuid())
  cycleId         String
  cycle           ReviewCycle      @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  questionText    String
  // Admin-only: never selected on any staff path.
  expectedOutcome String
  isLongAnswer    Boolean          @default(true)
  order           Int
  responses       ReviewResponse[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([cycleId, order])
}

model ReviewSubmission {
  id          String           @id @default(cuid())
  cycleId     String
  cycle       ReviewCycle      @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  staffId     String
  staff       User             @relation(fields: [staffId], references: [id], onDelete: Restrict)
  // First day (Lagos) of the review period this submission answers.
  periodStart DateTime         @db.Date
  submittedAt DateTime?
  isMissed    Boolean          @default(false)
  responses   ReviewResponse[]
  createdAt   DateTime         @default(now())

  @@unique([staffId, cycleId, periodStart])
}

model ReviewResponse {
  id           String           @id @default(cuid())
  submissionId String
  submission   ReviewSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     ReviewQuestion   @relation(fields: [questionId], references: [id], onDelete: Restrict)
  responseText String
  adminNote    String?
  createdAt    DateTime         @default(now())
}

model Task {
  id          String           @id @default(cuid())
  title       String
  description String?
  // "All Staff": one assignment per active staff member, added for new staff too.
  assignToAll Boolean          @default(false)
  dueDate     DateTime?        @db.Date
  createdById String
  createdBy   User             @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignments TaskAssignment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Per-person progress on a task (TRD §5.4).
model TaskAssignment {
  id          String     @id @default(cuid())
  taskId      String
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staffId     String
  staff       User       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  status      TaskStatus @default(PENDING)
  blockerNote String?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([taskId, staffId])
  @@index([staffId, status])
}

model DailyLog {
  id              String   @id @default(cuid())
  staffId         String
  staff           User     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  logDate         DateTime @db.Date
  activityText    String
  generalSetbacks String?
  submittedAt     DateTime
  editableUntil   DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([staffId, logDate])
  @@index([logDate])
}

model SetbackReport {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  staffId     String
  staff       User            @relation(fields: [staffId], references: [id], onDelete: Restrict)
  category    SetbackCategory
  description String
  createdAt   DateTime        @default(now())

  @@index([orderId])
  @@index([staffId])
}

// Visible to staff once scheduledFor has passed; no cron needed (TRD §12).
model Announcement {
  id           String             @id @default(cuid())
  title        String
  body         String
  scheduledFor DateTime
  createdById  String
  createdBy    User               @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reads        AnnouncementRead[]
  createdAt    DateTime           @default(now())

  @@index([scheduledFor])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  staffId        String
  staff          User         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  readAt         DateTime     @default(now())

  @@unique([announcementId, staffId])
}

// One claim per order. A raw-SQL partial unique index also limits each staff
// member to one order in production at a time (TRD §5.5).
model OrderClaim {
  id            String    @id @default(cuid())
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  staffId       String
  staff         User      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  claimedAt     DateTime  @default(now())
  markedReadyAt DateTime?

  @@index([staffId])
}

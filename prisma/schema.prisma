// Shared schema for the shop and (later) the staff portal.
// Models follow docs/yogurmac-shop-prd.md §6, plus the additions in
// docs/yogurmac-trd.md §5.4 (PendingCheckout, dedupeKey, SubscriptionPayment,
// Order.amountPaid). Money is Decimal(12,2) in naira; times are UTC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  YOGURT
  GRANOLA
  ENERGY_BAR
}

enum OrderStatus {
  CONFIRMED
  IN_PRODUCTION
  READY
  OUT_FOR_DELIVERY
  DELIVERED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String
  category    Category
  images      String[]
  isFeatured  Boolean          @default(false)
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, isFeatured])
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  flavour     String
  size        String
  price       Decimal     @db.Decimal(12, 2)
  isAvailable Boolean     @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([productId, flavour, size])
  @@index([productId])
}

model LGAShippingRate {
  id          String   @id @default(cuid())
  lgaName     String   @unique
  // Null means the admin has not set a fee yet; checkout is blocked for that LGA.
  shippingFee Decimal? @db.Decimal(12, 2)
  updatedAt   DateTime @updatedAt
}

// Holds a validated cart between payment initialisation and the Paystack
// webhook. The Order is only created from this once payment is confirmed.
model PendingCheckout {
  id            String    @id @default(cuid())
  orderId       String    @unique
  customerName  String
  customerEmail String
  customerPhone String
  lga           String
  exactAddress  String
  landmark      String?
  items         Json
  subtotal      Decimal   @db.Decimal(12, 2)
  shippingFee   Decimal   @db.Decimal(12, 2)
  total         Decimal   @db.Decimal(12, 2)
  accessCode    String?
  consumedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

model Order {
  id            String      @id @default(cuid())
  orderId       String      @unique
  customerName  String
  customerEmail String
  customerPhone String
  lga           String
  exactAddress  String
  landmark      String?
  subtotal      Decimal     @db.Decimal(12, 2)
  shippingFee   Decimal     @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  amountPaid    Decimal     @db.Decimal(12, 2)
  status        OrderStatus @default(CONFIRMED)
  paystackRef   String      @unique
  emailSent     Boolean     @default(false)
  emailError    String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([lga])
  @@index([customerPhone])
  @@index([customerName])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  // Snapshots taken at order time, so later catalogue edits never change an order.
  productName String
  flavour     String
  size        String
  quantity    Int
  unitPrice   Decimal        @db.Decimal(12, 2)

  @@index([orderId])
  @@index([variantId])
}

model SubscriptionTier {
  id               String         @id @default(cuid())
  name             String
  description      String
  monthlyAmount    Decimal        @db.Decimal(12, 2)
  paystackPlanCode String?        @unique
  isActive         Boolean        @default(true)
  sortOrder        Int            @default(0)
  subscriptions    Subscription[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Subscription {
  id                       String                @id @default(cuid())
  tierId                   String
  tier                     SubscriptionTier      @relation(fields: [tierId], references: [id], onDelete: Restrict)
  subscriberName           String
  subscriberEmail          String
  paystackSubscriptionCode String                @unique
  paystackCustomerCode     String
  status                   SubscriptionStatus    @default(ACTIVE)
  // Set by subscription.not_renew: stays ACTIVE until the paid period ends.
  endsAtPeriodEnd          Boolean               @default(false)
  // Set by invoice.payment_failed so the admin can follow up.
  lastPaymentFailedAt      DateTime?
  startDate                DateTime
  nextPaymentDate          DateTime?
  payments                 SubscriptionPayment[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@index([tierId, status])
  @@index([paystackCustomerCode])
}

model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  paystackRef    String       @unique
  amount         Decimal      @db.Decimal(12, 2)
  status         String
  paidAt         DateTime
  createdAt      DateTime     @default(now())
}

model ImpactStat {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  value     Int
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("PAYSTACK")
  eventType   String
  dedupeKey   String    @unique
  paystackRef String?
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  note        String?
  createdAt   DateTime  @default(now())
}

// Problems the admin must see on the staff dashboard: payment mismatches,
// payments with no pending checkout, failed emails.
model SystemAlert {
  id         String    @id @default(cuid())
  type       String
  message    String
  reference  String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolvedAt, createdAt])
}

// Insert-only. actorId is null for system actions (e.g. webhook-created orders).
model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

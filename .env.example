# ── Database ─────────────────────────────────────────────
# Local: run `npm run db:local` and paste the postgres:// URL it prints.
# Production: Neon pooled URL (DATABASE_URL) and direct URL (DIRECT_URL).
DATABASE_URL=""
DIRECT_URL=""
# The local Prisma dev server accepts one connection at a time.
DB_POOL_MAX="1"

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Public contact inbox (footer, privacy policy, reply-to on customer emails).
NEXT_PUBLIC_CONTACT_EMAIL="hello@yogurmacfoods.com"
# Signs the private link to each order page. Long random string, e.g. `openssl rand -base64 32`.
# Changing it breaks links in emails already sent (the order still shows, without the address).
ORDER_LINK_SECRET=""
# Extra origins allowed to call /api/checkout and /api/subscribe (comma separated)
ALLOWED_ORIGINS=""

# ── Paystack ─────────────────────────────────────────────
# Leave empty to use the simulated payment page (local only).
PAYSTACK_SECRET_KEY=""
# Not needed: the popup resumes a transaction the server started (access code only).
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# Comma-separated Paystack webhook IPs. Take the current list from Paystack's docs.
PAYSTACK_WEBHOOK_IPS=""

# ── Email (Resend) ───────────────────────────────────────
# Leave empty to print emails to the terminal instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="Yogurmac Foods <orders@yogurmacfoods.com>"

# ── Upstash Redis ────────────────────────────────────────
# Leave empty to use an in-memory cache and rate limiter (single process only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Vercel Cron ──────────────────────────────────────────
# Vercel sends this as a Bearer token to /api/cron/cleanup. Long random string.
CRON_SECRET=""

# ── Customer and admin logins (Neon Auth) ────────────────
# Cookie secret: openssl rand -base64 32. Password-reset emails are sent by
# Neon Auth. Add every site address to Neon Console → Auth → trusted domains.
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""

# Code a new admin enters at /admin/sign-up (share it only with people who
# should run the shop). Leave empty to close admin sign-up.
ADMIN_SIGNUP_CODE=""

# ── Database ─────────────────────────────────────────────
# Local: run `npm run db:local` and paste the postgres:// URL it prints.
# Production: Neon pooled URL (DATABASE_URL) and direct URL (DIRECT_URL).
DATABASE_URL=""
DIRECT_URL=""
# The local Prisma dev server accepts one connection at a time.
DB_POOL_MAX="1"

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Extra origins allowed to call /api/checkout and /api/subscribe (comma separated)
ALLOWED_ORIGINS=""

# ── Paystack ─────────────────────────────────────────────
# Leave empty to use the simulated payment page (local only).
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# Comma-separated Paystack webhook IPs. Take the current list from Paystack's docs.
PAYSTACK_WEBHOOK_IPS=""

# ── Email (Resend) ───────────────────────────────────────
# Leave empty to print emails to the terminal instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="Yogurmac Foods <orders@yogurmacfoods.com>"

# ── Upstash Redis ────────────────────────────────────────
# Leave empty to use an in-memory cache and rate limiter (single process only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Cross-app revalidation (staff portal calls the shop) ─
REVALIDATE_SECRET=""
